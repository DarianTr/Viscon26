# Copy to /home/viscon/viscon.env on the VM (NOT into the repo) and fill in.
# Read by .github/workflows/deploy.yml via `docker compose --env-file`.

# Use a long random value: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Port the reverse proxy forwards to — ask the organizers if unsure.
APP_PORT=3000

# true = load demo data into an empty database on first deploy.
SEED_DEMO_DATA=true

# Web Push: `npx web-push generate-vapid-keys`. Keep the pair stable — new keys
# invalidate every existing subscription. Empty = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
DEMO_USER_HANDLE=tprazak
