# Copy to /home/viscon/viscon.env on the VM (NOT into the repo) and fill in.
# Read by .github/workflows/deploy.yml via `docker compose --env-file`.

# Use a long random value: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Port the reverse proxy forwards to: 8080 by default (team page → Access
# Details → Edit Network Configuration). Stop the template first, it uses 8080:
#   cd ~/template && docker compose down
# Don't open this port in ufw: the app trusts the proxy's X-User-Id header.
APP_PORT=8080

# Web Push: `npx web-push generate-vapid-keys`. Keep the pair stable — new keys
# invalidate every existing subscription. Empty = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The admin account, created on first deploy. Empty = @admin, logged in as
# tprazak@ethz.ch (the X-User-Id the proxy sends).
ADMIN_HANDLE=
ADMIN_EMAIL=
ADMIN_NAME=

# Calendar subscriptions. The app's normal address is behind the organizers'
# login, which calendar apps can't pass, so the feed is served on the VM's
# direct address by the `direct` service (Caddy, gets its own HTTPS cert).
# Needs ports 80/443 on the VM open to the internet.
COMPOSE_PROFILES=direct
CALENDAR_FEED_ORIGIN=https://14-direct.viscon-hackathon.ch
# Where links back into the app (and anything but the feed on the direct
# address) go.
APP_ORIGIN=https://14.hackathon.ethz.ch
# Change if APP_PORT already uses 80 — HTTPS on 443 is enough for the cert.
# DIRECT_HTTP_PORT=80
# DIRECT_HTTPS_PORT=443
