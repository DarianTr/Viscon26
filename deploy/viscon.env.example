# Copy to /home/viscon/viscon.env on the VM (NOT into the repo) and fill in.
# Read by .github/workflows/deploy.yml via `docker compose --env-file`.

# Use a long random value: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Port the reverse proxy forwards to: 8080 by default (team page → Access
# Details → Edit Network Configuration). Stop the template first, it uses 8080:
#   cd ~/template && docker compose down
# Don't open this port in ufw: the app trusts the proxy's X-User-Id header.
APP_PORT=8080

# true = load demo data into an empty database on first deploy.
SEED_DEMO_DATA=true

# Web Push: `npx web-push generate-vapid-keys`. Keep the pair stable — new keys
# invalidate every existing subscription. Empty = push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
DEMO_USER_HANDLE=tprazak
# Your X-User-Id (e.g. jdoe@ethz.ch): you log in as the seeded demo admin.
DEMO_USER_EMAIL=
DEMO_USER_NAME=
