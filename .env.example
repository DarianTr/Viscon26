# Copy to .env.local and fill in. Everything here is server-only unless the
# name starts with NEXT_PUBLIC_, which exposes it to the browser.

# Matches docker-compose.yml. Point at any Postgres (Neon, Supabase, …) in prod.
DATABASE_URL=postgres://stride:stride@localhost:5432/stride

# There is no auth yet — every request acts as this seeded user.
DEMO_USER_HANDLE=tprazak

# Knowledge-state service (services/knowledge). docker compose sets this for the app.
KNOWLEDGE_URL=http://localhost:8000

# NEXT_PUBLIC_APP_NAME=Viscon26
