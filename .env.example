# Copy to .env.local and fill in. Everything here is server-only unless the
# name starts with NEXT_PUBLIC_, which exposes it to the browser.

# Matches docker-compose.yml. Point at any Postgres (Neon, Supabase, …) in prod.
DATABASE_URL=postgres://stride:stride@localhost:5432/stride

# Login comes from the VIScon reverse proxy's X-User-Id / X-User-Name headers.
# Locally there is no proxy, so these stand in for them. An email without a
# profile yet is sent to /signup.
DEV_USER_ID=jdoe@ethz.ch
DEV_USER_NAME=Jörg Doe

# Used by `npm run db:seed` / `db:reset`: the seeded admin with all the demo
# data. Set DEMO_USER_EMAIL to your DEV_USER_ID (and handle/name to yours) to
# get the demo data on your own account.
DEMO_USER_HANDLE=tprazak
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_NAME=Tomas P.

# Knowledge-state service (services/knowledge). docker compose sets this for the app.
KNOWLEDGE_URL=http://localhost:8000

# Web Push (challenge notifications and daily nudges). Generate a pair with
# `npx web-push generate-vapid-keys`. Leave empty to turn push off; nothing
# else breaks. VAPID_SUBJECT is a contact address push services can reach.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# NUDGES=off stops the daily "go study" pushes.

# NEXT_PUBLIC_APP_NAME=Viscon26
