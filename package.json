{
  "name": "viscon26",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/lib/scheduler.test.ts src/lib/intervals.test.ts src/lib/plan-progress.test.ts src/lib/move-rules.test.ts src/lib/weekly-goal.test.ts src/lib/ical.test.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "db:seed-knowledge": "tsx --env-file-if-exists=.env.local src/db/seed-knowledge.ts",
    "db:seed-courses": "tsx --env-file-if-exists=.env.local src/db/seed-courses.ts",
    "db:set-password": "tsx --env-file-if-exists=.env.local src/db/set-password.ts",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "openai": "^7.32.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
